POSTGRES_USER=gmaps
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gmaps
DATABASE_URL=postgresql+psycopg://gmaps:change-me@postgres:5432/gmaps

REDIS_URL=redis://redis:6379/0

# This compose setup doesn't bundle the scraper engine itself — it expects
# one already running and reachable. If it's running as a `-web` process on
# the same host (not in a container), use host.docker.internal as below; if
# you add it back as its own service in docker-compose.yml, point this at
# http://gmaps-scraper:8080 instead.
GMAPS_SCRAPER_BASE_URL=http://host.docker.internal:8080

# Leave empty to disable API key auth (not recommended outside local dev).
API_KEY=change-me

# Comma-separated list of origins allowed to call this API from a browser,
# e.g. "https://dashboard.example.com". Leave empty to block all browser
# cross-origin calls (server-to-server calls are unaffected either way).
ALLOWED_ORIGINS=

# How often the worker polls the scraper engine for job status, in seconds.
POLL_INTERVAL_SECONDS=10

# Safety margin added on top of a job's own max_time before the worker gives
# up waiting on it and marks it failed.
POLL_TIMEOUT_BUFFER_SECONDS=120

# Delete the job from the scraper engine's own storage once we've pulled
# results into Postgres, to keep its data folder from growing unbounded.
CLEANUP_ENGINE_JOB=true
